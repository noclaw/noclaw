# NoClaw - Environment Configuration
# Copy this file to .env and fill in your credentials

# ==== AUTHENTICATION (Required - Choose One) ====

# Option 1: Claude Code OAuth Token
# Get your token by running: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token-here

# Option 2: Anthropic API Key (for direct API access)
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ==== SECURITY ====

# API key for webhook/API endpoints (optional - unset allows all requests)
# Generate with: openssl rand -hex 32
# NOCLAW_API_KEY=your-random-api-key-here

# Dashboard login password (optional - unset allows open access)
# Set to a memorable password for the web control panel
# NOCLAW_PASSWORD=your-dashboard-password

# ==== SERVER CONFIGURATION ====

# Port (default: 3000)
PORT=3000

# Data directory for SQLite database (default: data)
DATA_DIR=data

# Agent timeout in seconds (default: 300)
AGENT_TIMEOUT=300

# Timezone for Google Calendar and Gmail (default: America/Denver)
TIMEZONE=America/Denver

# ==== LOGGING ====

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional Agent performance log file (JSON lines format)
# AGENT_LOG_FILE=data/agents.jsonl

# Save raw conversation logs to workspace/conversations/ (default: off)
# LOG_CONVERSATIONS=true

# ==== TELEGRAM BOT (Optional) ====
# Run: python3 setup.py (interactive setup)

# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_USER_ID=your-numeric-telegram-id
# TELEGRAM_MODEL_HINT=sonnet

# ==== SLACK BOT (Optional) or slack skill ====
# Run: python3 setup.py (interactive setup)

# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-level-token
# SLACK_USER_ID=U12345678
# SLACK_MODEL_HINT=sonnet
# SLACK_MONITORED_CHANNELS=channel1,channel2 (comma-separated list of channel names or IDs)

# ==== GOOGLE INTEGRATIONS (Optional) ====
# Run: python3 setup.py (Google step handles OAuth and dependencies)

# GOOGLE_CALENDAR_ID=
