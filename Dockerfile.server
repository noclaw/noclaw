# NoClaw Server - FastAPI + Claude Code CLI
FROM python:3.11-slim

# Install Node.js (required for Claude Code CLI)
RUN apt-get update && apt-get install -y curl git tmux gosu && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI and agent-browser
RUN npm install -g @anthropic-ai/claude-code agent-browser

# Install Chromium dependencies for agent-browser (headless browsing)
RUN npx playwright install --with-deps chromium

# Create non-root user
RUN useradd -m -s /bin/bash noclaw

WORKDIR /app

# Install Python dependencies
COPY server/requirements.txt /app/server/
RUN pip install --no-cache-dir -r server/requirements.txt

# Copy application code
COPY server/ /app/server/
COPY run_assistant.py /app/

# Create data and workspace directories
RUN mkdir -p /app/data /app/workspace && chown -R noclaw:noclaw /app

# Copy entrypoint script
COPY entrypoint.sh /app/entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Start as root, entrypoint fixes permissions then drops to noclaw user
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "run_assistant.py"]
