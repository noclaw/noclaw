# NoClaw - Environment Configuration
# Copy this file to .env and fill in your credentials

# ==== AUTHENTICATION (Required - Choose One) ====

# Option 1: Claude Code OAuth Token
# Get your token by running: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token-here

# Option 2: Anthropic API Key (for direct API access)
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ==== WEBHOOK AUTHENTICATION ====

# API key for webhook endpoints (optional - unset allows all requests)
# NOCLAW_API_KEY=your-secret-key-here

# ==== SERVER CONFIGURATION ====

# Port (default: 3000)
PORT=3000

# Data directory for SQLite and workspaces (default: data)
DATA_DIR=data

# Sandbox type: "local" (default) or "docker" (requires Docker/Podman)
SANDBOX_TYPE=local

# Agent timeout in seconds (default: 300)
AGENT_TIMEOUT=300

# ==== LOGGING ====

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Agent performance log file (JSON lines format)
AGENT_LOG_FILE=data/agents.jsonl

# ==== TELEGRAM BOT (Optional) ====
# See: /add-telegram skill for setup wizard

# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_USER_ID=your-numeric-telegram-id
# TELEGRAM_MODEL_HINT=sonnet

# ==== SLACK BOT (Optional) ====
# See: /add-slack skill for setup wizard

# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-level-token
# SLACK_USER_ID=U12345678
# SLACK_MODEL_HINT=sonnet
